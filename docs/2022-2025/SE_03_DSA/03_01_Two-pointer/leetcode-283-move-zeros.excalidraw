    {
      "id": "r2No1h4-Di9N2E-vZFVg8",
      "type": "text",
      "x": 1116.1731847587068,
      "y": 36,
      "width": 384.7704186755166,
      "height": 216.34549274255195,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
