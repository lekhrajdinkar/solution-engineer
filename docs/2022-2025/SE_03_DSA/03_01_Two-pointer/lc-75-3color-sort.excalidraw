      "link": null,
      "locked": false,
      "text": "class Solution:\n    def moveZeroes(self, nums: List[int]) -> None:\n        print('Before ',nums)\n        nums[:] = list(filter(lambda x: x!= 0, nums)) + ([0]*nums.count(0))\n        print('After ',nums)",
      "fontSize": 16.40000000000001,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def moveZeroes(self, nums: List[int]) -> None:\n        print('Before ',nums)\n        nums[:] = list(filter(lambda x: x!= 0, nums)) + ([0]*nums.count(0))\n        print('After ',nums)",
      "autoResize": true,
      "lineHeight": 1.25
    },
