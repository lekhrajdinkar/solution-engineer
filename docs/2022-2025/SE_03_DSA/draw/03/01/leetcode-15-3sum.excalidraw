    {
      "id": "r2No1h4-Di9N2E-vZFVg8",
      "type": "text",
      "x": 1116.1731847587068,
      "y": 36,
      "width": 384.7704186755166,
      "height": 216.34549274255195,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 839296672,
      "version": 833,
      "versionNonce": 1867826848,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788392686617,
      "link": null,
      "locked": false,
      "text": "\npublic static void moveZeroes(int[] nums) {\n    int nextNonZero = 0;\n    for (int i = 0; i < nums.length; i++) {\n        if (nums[i] != 0) {\n            int temp = nums[nextNonZero];\n            nums[nextNonZero] = nums[i];\n            nums[i] = temp;\n            nextNonZero++;\n        }\n    }\n}",
      "fontSize": 14.423032849503466,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\npublic static void moveZeroes(int[] nums) {\n    int nextNonZero = 0;\n    for (int i = 0; i < nums.length; i++) {\n        if (nums[i] != 0) {\n            int temp = nums[nextNonZero];\n            nums[nextNonZero] = nums[i];\n            nums[i] = temp;\n            nextNonZero++;\n        }\n    }\n}",
      "autoResize": false,
      "lineHeight": 1.25
    },
